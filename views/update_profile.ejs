<!DOCTYPE html>
<html lang="it">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Modifica profilo</title>

   <!-- font awesome cdn link  -->
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">

   <!-- custom css file link  -->
   <link rel="stylesheet" href="../css/admin_style.css">

</head>
<body>

<%- include('./admin_header') %>

<!-- admin profile update section starts  -->

<section class="form-container">

   <form action="/updateProfile" method="POST">
      <h3>modifica profilo</h3>
      <input type="text" name="name" maxlength="20" class="box" oninput="this.value = this.value.replace(/\s/g, '')" placeholder="<%= admin.name %>">
      <input type="password" name="old_pass" maxlength="20" placeholder="inserisci vecchia password" class="box" oninput="this.value = this.value.replace(/\s/g, '')">
      <input type="password" name="new_pass" maxlength="20" placeholder="inserisci nuova password" class="box" oninput="this.value = this.value.replace(/\s/g, '')">
      <input type="password" name="confirm_pass" maxlength="20" placeholder="conferma nuova password" class="box" oninput="this.value = this.value.replace(/\s/g, '')">
      <input type="submit" value="modifica" name="submit" class="btn">
    </form>

</section>

<!-- admin profile update section ends -->

<!-- custom js file link  -->
<script src="/js/admin_script.js"></script>

</body>
</html>