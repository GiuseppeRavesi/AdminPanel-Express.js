<!DOCTYPE html>
<html lang="it">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>dashboard</title>

   <!-- font awesome cdn link  -->
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">

   <!-- custom css file link  -->
   <link rel="stylesheet" href="/css/admin_style.css">

</head>
<body>

<%- include('./admin_header') %>

<!-- admin dashboard section starts  -->

<section class="dashboard">

   <h1 class="heading">dashboard</h1>

   <div class="box-container">

   <div class="box">
      <h3>benvenuto!</h3>
      <p><%= admin.name %></p>
      <a href="/update_profile" class="btn">aggiorna profilo</a>
   </div>

   <div class="box">
      <h3><span>$</span><%= total_pendings %></h3>
      <p>ordini in coda</p>
      <a href="/placed_orders?status=pending" class="btn">vedi ordini</a>
   </div>


   <div class="box">
      <h3><span>$</span><%= total_completed; %></h3>
      <p>ordini completati</p>
      <a href="/placed_orders?status=COMPLETED" class="btn">vedi ordini</a>
   </div>

   <div class="box">
      <h3><%= total_orders; %></h3>
      <p>ordini totali</p>
      <a href="/placed_orders" class="btn">vedi ordini</a>
   </div>
   
   <div class="box">      
      <h3><%= numbers_of_products; %></h3>
      <p>prodotti disponibili</p>
      <a href="/products" class="btn">vedi prodotti</a>
   </div>

   <div class="box">
      <h3><%= number_users; %></h3>
      <p>account utenti</p>
      <a href="/user_account" class="btn">vedi utenti</a>
   </div>

   <div class="box">
      <h3><%= number_admins; %></h3>
      <p>admin</p>
      <a href="/admin_accounts" class="btn">vedi admin</a>
   </div>

   <div class="box">
      <h3><%= number_messages; %></h3>
      <p>nuovi messaggi</p>
      <a href="/messages" class="btn">vedi messaggi</a>
   </div>

   </div>

</section>

<!-- admin dashboard section ends -->


<!-- custom js file link  -->
<script src="/js/admin_script.js"></script>

</body>
</html>