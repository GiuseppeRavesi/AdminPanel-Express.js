<!DOCTYPE html>
<html lang="it">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>admins accounts</title>

   <!-- font awesome cdn link  -->
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">

   <!-- custom css file link  -->
   <link rel="stylesheet" href="/css/admin_style.css">

</head>
<body>

<%- include('./admin_header') %>

<!-- admins accounts section starts  -->

<section class="accounts">
    <h1 class="heading">admins account</h1>
 
    <div class="box-container">
       <div class="box">
          <p>registra un nuovo admin</p>
          <a href="/admin_register" class="option-btn">registra</a>
       </div>
 
       <% if (admins && admins.length > 0) { %>
          <% admins.forEach(admin => { %>
             <div class="box">
                <p> admin id : <span><%= admin.id %></span> </p>
                <p> username : <span><%= admin.name %></span> </p>
                <div class="flex-btn">
                    <button class="delete-btn" data-id="<%= admin.id %>">elimina</button>
                </div>
             </div>
          <% }); %>
       <% } else { %>
          <p class="empty">nessun account disponibile</p>
       <% } %>
    </div>
 </section>
 
<!-- admins accounts section ends -->

<!-- custom js file link  -->
<script src="/js/admin_script.js"></script>
<script src="/js/deleteAdmin.js"></script>

</body>
</html>